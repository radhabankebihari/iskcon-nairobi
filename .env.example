# Client-owned Apps Script deployment. Keep both values server-side only.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Analytics writes only on a production build. Set to true to also stop them there.
ANALYTICS_DISABLED=
PUSH_SUBSCRIBER_COUNT_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
